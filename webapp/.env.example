# Copy this file to `.env` (git-ignored) and fill in real values.
#
# OAuth 2.0 Web-application client from Google Cloud Console
# (APIs & Services → Credentials). The client ID is public by design and is
# the ONLY value the browser needs; never create or expose a client secret
# for this app.
#
# Authorized JavaScript origins for the client must include every origin the
# app is served from, e.g.:
#   http://localhost:5173                     (local dev server)
#   https://<owner>.github.io                 (GitHub Pages)
VITE_GOOGLE_CLIENT_ID=
